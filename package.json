{
  "name": "pixelcreator",
  "version": "1.0.0",
  "description": "Generador de plantillas de beads (Hama, Perler) a partir de imágenes",
  "main": "./out/main/index.js",
  "desktopName": "pixelcreator.desktop",
  "author": {
    "name": "Gustavo Adolfo Garrido Tapia",
    "email": "gustavogarrido.programador@gmail.com"
  },
  "homepage": "https://gustavo-dev.netlify.app/",
  "scripts": {
    "format": "prettier --write .",
    "test": "vitest run",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^1.0.2",
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "jsdom": "^25.0.1",
    "jspdf": "^4.2.1",
    "postcss": "^8.4.39",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.0.7",
    "react-icons": "^5.2.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^3.4.5",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
